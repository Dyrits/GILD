{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "python3 -I \"$GEMINI_PROJECT_DIR/.agents/hooks/guard-git.py\" --level 2 --protected main,master",
            "name": "guard-git",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      }
    ]
  }
}
