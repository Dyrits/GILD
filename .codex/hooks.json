{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-git.py\" --level 2 --protected main,master",
            "statusMessage": "Checking Git command",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ]
  }
}
