{
  "name": "iskios",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "dev": "bun run --filter desktop dev",
    "format": "biome check --write .",
    "package": "bun run --filter desktop package",
    "prepare": "git config core.hooksPath .githooks",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@effect/vitest": "4.1.4",
    "electron": "45.3.1",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
