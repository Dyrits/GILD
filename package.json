{
  "name": "openmission",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun run --filter desktop dev",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@effect/vitest": "4.1.2",
    "electron": "45.2.3",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
